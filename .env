# =============================================================================
# Benchmark 3W — Variáveis de Ambiente
# Dataset: Petrobras 3W (séries temporais de sensores de poços offshore)
#
# IMPORTANTE: Não versionar este arquivo com credenciais reais.
#             O .gitignore deve incluir ".env".
#             Use ".env.example" para compartilhar o template com a equipe.
# =============================================================================

# -----------------------------------------------------------------------------
# Dataset
# -----------------------------------------------------------------------------

# Caminho local do diretório clonado do repositório 3W da Petrobras.
# Deve apontar para o subdiretório "dataset/" dentro do repositório clonado.
# Exemplo: se clonou em /home/user/3W, use /home/user/3W/dataset
DATASET_PATH=/data/3w/dataset

# -----------------------------------------------------------------------------
# Kafka
# -----------------------------------------------------------------------------

# Bootstrap servers dos brokers Kafka.
# Dentro da rede Docker: usar nomes de serviço (kafka-1, kafka-2, kafka-3).
# Do host: usar localhost:9092,localhost:9093,localhost:9094
KAFKA_BROKERS=kafka-1:9092,kafka-2:9092,kafka-3:9092

# Tópico principal de ingestão de dados dos sensores 3W.
KAFKA_TOPIC=3w-sensors

# Tópico de saída com resultados processados (latências, features).
KAFKA_RESULTS_TOPIC=3w-results

# Consumer group do Flink (usado para calcular consumer lag).
KAFKA_FLINK_GROUP_ID=flink-3w-consumer

# Consumer group do Spark (usado para calcular consumer lag).
KAFKA_SPARK_GROUP_ID=spark-3w-consumer

# -----------------------------------------------------------------------------
# Apache Flink
# -----------------------------------------------------------------------------

# Hostname do Flink JobManager (REST API).
FLINK_JM_HOST=localhost

# Porta REST do Flink JobManager (Flink Web UI).
FLINK_JM_PORT=8081

# Paralelismo padrão dos jobs Flink.
FLINK_PARALLELISM=4

# Diretório de checkpoints do Flink (dentro dos containers).
FLINK_CHECKPOINT_DIR=file:///tmp/flink-checkpoints

# -----------------------------------------------------------------------------
# Apache Spark
# -----------------------------------------------------------------------------

# URL do Spark Master para submissão de jobs.
SPARK_MASTER=spark://spark-master:7077

# Porta da Spark Application UI (driver).
SPARK_UI_PORT=4040

# Diretório de checkpoints do Spark Structured Streaming.
SPARK_CHECKPOINT_DIR=/tmp/spark-checkpoints

# -----------------------------------------------------------------------------
# Observabilidade
# -----------------------------------------------------------------------------

# URL base do Prometheus.
PROMETHEUS_URL=http://localhost:9090

# URL do Prometheus Pushgateway (métricas do producer Python).
PUSHGATEWAY_URL=http://localhost:9091

# URL do Grafana.
GRAFANA_URL=http://localhost:3000

# Credenciais Grafana (alterar em produção).
GRAFANA_USER=admin
GRAFANA_PASSWORD=benchmark3w

# URL do Kafka Exporter (consumer lag → Prometheus).
KAFKA_EXPORTER_URL=http://localhost:9308

# -----------------------------------------------------------------------------
# Benchmark
# -----------------------------------------------------------------------------

# Diretório raiz para salvar resultados dos experimentos.
RESULTS_PATH=./results

# Multiplicador de velocidade de replay padrão (1.0 = tempo real).
SPEED_FACTOR=1.0

# Duração padrão de cada experimento em segundos (600s = 10 min).
EXPERIMENT_DURATION_S=600

# Duração do período de warm-up em segundos (descartado da análise).
WARMUP_DURATION_S=180

# -----------------------------------------------------------------------------
# Docker Compose
# -----------------------------------------------------------------------------

# Nome do projeto docker-compose (prefixo dos containers).
# Usado também pelo FaultInjector para montar nomes de containers.
COMPOSE_PROJECT_NAME=benchmark3w

# -----------------------------------------------------------------------------
# Airflow (se usar o scheduler local fora do Docker)
# -----------------------------------------------------------------------------

# Diretório home do Airflow.
AIRFLOW_HOME=./airflow

# URL do banco de dados do Airflow.
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=sqlite:///./airflow/airflow.db

# Desabilita exemplos na UI do Airflow.
AIRFLOW__CORE__LOAD_EXAMPLES=False

# Diretório das DAGs.
AIRFLOW__CORE__DAGS_FOLDER=./airflow_dags
